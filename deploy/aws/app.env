# Non-secret settings for the demo instance (t4g.small: 2 GB RAM + 2 GB swap).
# Secrets (OPENAI_API_KEY, DATABASE_URL, LANGSMITH_API_KEY, ORIGIN_SECRET) come from SSM Parameter Store.
# Docker env-file format: one KEY=value per line, comments only on their own lines.

# One web process and one ingestion worker: a PDF child process may take up to PDF_PARSE_MEMORY_MB,
# so two concurrent parses plus the app could exhaust 2 GB.
WEB_CONCURRENCY=1
WORKER_CONCURRENCY=1
PDF_PARSE_MEMORY_MB=768

# Supabase session pooler allows 15 clients; one process x 5 stays well under it.
DB_POOL_MAX=5

LANGSMITH_PROJECT=hybrid-rag
LANGSMITH_TRACING=false

# Open mode: no API key needed; everyone shares the "public" library (daily caps still apply).
PUBLIC_TENANT=public
