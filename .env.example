OPENAI_API_KEY=sk-your-openai-key   # embeddings, answers, rerank, follow-up rewrite, OCR

# Supabase > Connect > Session pooler string (aws-N-<region>.pooler.supabase.com:5432). The direct
# db.<ref>.supabase.co host is IPv6-only and fails on most networks. Transaction pooler (6543) also works
# and allows far more clients; keep (server processes x DB_POOL_MAX) under the session pooler's limit (15).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# API keys live in the database: create them with `python admin.py create-key <team>`.

# LangSmith: evaluation (evaluate.py) and optional tracing + thumbs-up/down feedback of live queries
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hybrid-rag

# Optional overrides (defaults shown)
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=768
AUX_MODEL=gpt-4o-mini
AUX_TIMEOUT_S=5
OCR_MODEL=gpt-4o-mini
PDF_OCR=auto
RERANK=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.30
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=1000
DAILY_QUERIES=500
DAILY_TOKENS=300000
DAILY_UPLOAD_MB=200
DAILY_OCR_PAGES=50
GLOBAL_DAILY_TOKENS=1000000
GLOBAL_DAILY_OCR_PAGES=100
RUN_WORKER=true
WORKER_CONCURRENCY=2
DB_POOL_MAX=5

# Set only behind CloudFront/a proxy that adds X-Origin-Secret (deploy.sh manages it on AWS)
# ORIGIN_SECRET=
# Interactive OpenAI calls: timeout x (1 + retries) must fit the proxy's 60 s origin timeout
OPENAI_TIMEOUT_S=20
OPENAI_MAX_RETRIES=1
PDF_PARSE_MEMORY_MB=1024
